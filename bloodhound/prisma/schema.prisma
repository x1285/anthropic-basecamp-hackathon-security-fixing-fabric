// Bloodhound data model. Mirrors the domain in packages/core/src/model.ts (aligned with the target UI).
// The demo world is relational; a run is stored as one snapshot, the same way the UI keeps it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Environment {
  id          String  @id
  position    Int
  name        String
  slaCritical Int?
  slaHigh     Int?
  slaMedium   Int?
  slaLow      Int?
  ticket      Boolean
  slack       Boolean
  channel     String
  page        String
  links       ProjectCustomer[]
}

model Customer {
  id               String  @id
  position         Int
  name             String
  tier             String
  slaCritical      Int?
  slaHigh          Int?
  slaMedium        Int?
  slaLow           Int?
  contact          String
  notifyUnaffected Boolean
  links            ProjectCustomer[]
}

model Project {
  id       String  @id
  position Int
  name     String
  owner    String
  repos    Repo[]
  links    ProjectCustomer[]
}

/** Which customers sit on which environment of a project. */
model ProjectCustomer {
  projectId  String
  envId      String
  customerId String
  position   Int
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  env        Environment @relation(fields: [envId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([projectId, envId, customerId])
}

model Repo {
  id        String  @id
  projectId String
  position  Int
  name      String
  ecosystem String
  watched   Boolean
  source    String
  tests     String
  deployed  Json
  releases  Json
  deps      Dep[]
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Dep {
  id       String @id @default(uuid())
  repoId   String
  position Int
  name     String
  version  String
  direct   Boolean
  via      String
  env      Json
  repo     Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

/** One incident run. data holds the full snapshot (scan, groups, recipes, repo states, outbox). */
model Run {
  id         String   @id
  firedAt    DateTime
  incidentId String
  data       Json

  @@index([firedAt])
}

model AuditLog {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now())
  actor  String
  action String
  target String
}
